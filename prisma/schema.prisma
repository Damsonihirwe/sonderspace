generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model TeeRequest {
  id           String   @id @default(cuid())
  artistName   String
  customerName String
  phone        String
  type         String
  notes        String
  createdAt    DateTime @default(now())

  @@index([createdAt])
}